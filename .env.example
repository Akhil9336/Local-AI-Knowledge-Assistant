# Optional overrides. No cloud API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=bge-m3
RAG_DATA_DIR=data
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# Optional cosine similarity score threshold from -1 to 1
# RAG_SIMILARITY_THRESHOLD=0.25
RAG_MAX_FILE_MB=50
OLLAMA_TIMEOUT=120
